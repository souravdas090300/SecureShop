@page
@model AdminProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="color: #1e293b;">My Profile</h2>
        <p class="text-muted mb-0">Your administrator account details.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <!-- Avatar -->
                <div class="text-center mb-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:80px;height:80px;background:linear-gradient(135deg,#3b82f6,#10b981);font-size:2rem;color:white;font-weight:700;">
                        @(Model.AdminName.Length > 0 ? Model.AdminName.Substring(0, 1).ToUpper() : "A")
                    </div>
                    <h5 class="fw-bold mb-0">@Model.AdminName</h5>
                    <span class="badge bg-primary mt-1">Administrator</span>
                </div>

                <hr />

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">First Name</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.FirstName) ? "—" : Model.FirstName)</dd>

                    <dt class="col-sm-4 text-muted">Last Name</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.LastName) ? "—" : Model.LastName)</dd>

                    <dt class="col-sm-4 text-muted">Email</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Email) ? "—" : Model.Email)</dd>

                    <dt class="col-sm-4 text-muted">Role</dt>
                    <dd class="col-sm-8"><span class="badge bg-danger">Admin</span></dd>
                </dl>
            </div>
        </div>
    </div>
</div>
