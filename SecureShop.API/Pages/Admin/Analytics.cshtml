@page "/admin/analytics"
@model SecureShop.API.Pages.Admin.AnalyticsModel
@{ ViewData["Title"] = "Analytics"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="fas fa-chart-pie me-2"></i>Analytics</h2>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
            <li class="breadcrumb-item active">Analytics</li>
        </ol></nav>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-4" id="analyticsCards">
    <div class="col-12 text-center py-4"><div class="spinner-border text-primary"></div></div>
</div>

<div class="row g-4">
    <!-- Order Status Breakdown -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-semibold">Order Status Breakdown</h5>
            </div>
            <div class="card-body" id="statusBreakdown">
                <div class="text-muted">Loading...</div>
            </div>
        </div>
    </div>

    <!-- Top Selling Products (Placeholder for now) -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-semibold">Inventory Health</h5>
            </div>
            <div class="card-body" id="inventoryHealth">
                <div class="text-muted">Loading...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const apiBaseUrl = '@Model.ApiBaseUrl';
    const token = document.querySelector('meta[name="admin-token"]')?.content ?? '';

    async function loadAnalytics() {
        try {
            // Fetch orders and products in parallel
            const [ordersRes, productsRes] = await Promise.all([
                fetch(`${apiBaseUrl}/api/orders`, { headers: { 'Authorization': `Bearer ${token}` } }),
                fetch(`${apiBaseUrl}/api/products?pageSize=100`, { headers: { 'Authorization': `Bearer ${token}` } })
            ]);

            const orders = ordersRes.ok ? await ordersRes.json() : [];
            const productsData = productsRes.ok ? await productsRes.json() : { items: [] };
            const products = Array.isArray(productsData) ? productsData : (productsData.items ?? []);

            // --- Calculations ---
            const totalRevenue = orders
                .filter(o => [2, 3, 4].includes(getStatusValue(o.status)))
                .reduce((sum, o) => sum + (o.totalAmount ?? 0), 0);
            
            const pendingOrders = orders.filter(o => [0, 1].includes(getStatusValue(o.status))).length;
            const deliveredOrders = orders.filter(o => getStatusValue(o.status) === 4).length;
            const avgOrderValue = orders.length > 0 ? totalRevenue / orders.length : 0;

            // --- Render KPI Cards ---
            document.getElementById('analyticsCards').innerHTML = `
                <div class="col-md-3">
                    <div class="stat-card">
                        <p class="text-muted mb-2">Total Revenue</p>
                        <h3 class="fw-bold text-success">$${totalRevenue.toFixed(2)}</h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <p class="text-muted mb-2">Total Orders</p>
                        <h3 class="fw-bold text-primary">${orders.length}</h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <p class="text-muted mb-2">Avg. Order Value</p>
                        <h3 class="fw-bold">$${avgOrderValue.toFixed(2)}</h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <p class="text-muted mb-2">Awaiting Payment</p>
                        <h3 class="fw-bold text-warning">${pendingOrders}</h3>
                    </div>
                </div>
            `;

            // --- Render Status Breakdown ---
            const statusMap = {0:'Pending',1:'Payment processing',2:'Paid',3:'Shipped',4:'Delivered',5:'Cancelled'};
            const classMap = {0:'warning',1:'info',2:'success',3:'primary',4:'success',5:'danger'};
            
            const statusHtml = [0, 1, 2, 3, 4, 5].map(status => {
                const count = orders.filter(o => getStatusValue(o.status) === status).length;
                const percent = orders.length > 0 ? (count / orders.length) * 100 : 0;
                return `
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-${classMap[status]}">${statusMap[status]}</span>
                            <span class="fw-bold">${count}</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-${classMap[status]}" role="progressbar" style="width: ${percent}%"></div>
                        </div>
                    </div>
                `;
            }).join('');
            document.getElementById('statusBreakdown').innerHTML = statusHtml;

            // --- Render Inventory Health ---
            const lowStock = products.filter(p => p.stockQuantity > 0 && p.stockQuantity < 10).length;
            const outOfStock = products.filter(p => p.stockQuantity === 0).length;
            const healthyStock = products.filter(p => p.stockQuantity >= 10).length;

            document.getElementById('inventoryHealth').innerHTML = `
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span>Healthy Stock (10+)</span>
                    <strong class="text-success">${healthyStock}</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span>Low Stock (1-9)</span>
                    <strong class="text-warning">${lowStock}</strong>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span>Out of Stock</span>
                    <strong class="text-danger">${outOfStock}</strong>
                </div>
                <div class="mt-3 text-muted small">
                    Total active products: ${products.length}
                </div>
            `;

        } catch (error) {
            console.error('Error loading analytics:', error);
            document.getElementById('analyticsCards').innerHTML = '<div class="alert alert-danger">Failed to load analytics data.</div>';
        }
    }

    function getStatusValue(status) {
        const names = { Pending: 0, PaymentProcessing: 1, Processing: 1, Paid: 2, Shipped: 3, Delivered: 4, Completed: 4, Cancelled: 5 };
        return typeof status === 'string' ? names[status] : status;
    }

    document.addEventListener('DOMContentLoaded', loadAnalytics);
</script>
}