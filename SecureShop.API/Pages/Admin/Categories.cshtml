@page
@model SecureShop.API.Pages.Admin.CategoriesModel
@{ ViewData["Title"] = "Categories"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="fas fa-tags me-2"></i>Categories</h2>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
            <li class="breadcrumb-item active">Categories</li>
        </ol></nav>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Add Category</h5>
                <div class="mb-3">
                    <label class="form-label">Category Name</label>
                    <input type="text" class="form-control" id="categoryName" placeholder="e.g. Smartphones">
                </div>
                <button class="btn btn-primary w-100" onclick="addCategory()">Add Category</button>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Existing Categories</h5>
                <div id="categoryList" class="list-group">
                    <div class="text-muted">Loading...</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const apiBaseUrl = '@Model.ApiBaseUrl';
    const token = document.querySelector('meta[name="admin-token"]')?.content ?? '';

    async function loadCategories() {
        const list = document.getElementById('categoryList');
        list.innerHTML = '<div class="text-muted">Loading...</div>';
        
        try {
            const res = await fetch(`${apiBaseUrl}/api/categories`);
            if (!res.ok) throw new Error('Failed');
            const categories = await res.json();
            
            if (categories.length === 0) {
                list.innerHTML = '<div class="text-muted">No categories yet.</div>';
                return;
            }

            list.innerHTML = categories.map(c => `
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="fas fa-tag text-muted me-2"></i>${c.name}</span>
                    <button class="btn btn-sm btn-outline-danger" onclick="deleteCategory('${c.id}')"><i class="fas fa-trash"></i></button>
                </div>
            `).join('');
        } catch (e) {
            list.innerHTML = '<div class="text-danger">Failed to load categories.</div>';
        }
    }

    async function addCategory() {
        const name = document.getElementById('categoryName').value.trim();
        if (!name) return alert('Enter a category name');

        try {
            // Read the token from the meta tag set by _AdminLayout
            const token = document.querySelector('meta[name="admin-token"]')?.content ?? '';
            
            const res = await fetch(`${apiBaseUrl}/api/categories`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify({ name })
            });
            if (res.ok) {
                document.getElementById('categoryName').value = '';
                loadCategories();
            } else {
                alert('Failed to add category');
            }
        } catch (e) {
            alert('Server error');
        }
    }

    async function deleteCategory(id) {
        if (!confirm('Delete this category?')) return;
        try {
            const res = await fetch(`${apiBaseUrl}/api/categories/${id}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${token}` }
            });
            if (res.ok) loadCategories();
        } catch (e) { alert('Failed'); }
    }

    document.addEventListener('DOMContentLoaded', loadCategories);
</script>
}