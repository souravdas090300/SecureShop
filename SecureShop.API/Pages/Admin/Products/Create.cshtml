@page
@model SecureShop.API.Pages.Admin.Products.AdminProductCreateModel
@{ ViewData["Title"] = "Add Product"; }

<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/admin/products" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h2 class="fw-bold mb-0">Add New Product</h2>
        <nav aria-label="breadcrumb"><ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/admin/products">Products</a></li>
            <li class="breadcrumb-item active">Create</li>
        </ol></nav>
    </div>
</div>

<div class="row g-4">
    <!-- Left: Form -->
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <div id="formAlert"></div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold">Product Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="productName" placeholder="e.g. Wireless Headphones">
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="productDescription" rows="4" placeholder="Describe the product..."></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Price <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" id="productPrice" step="0.01" min="0" placeholder="0.00">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Stock Quantity <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="productStock" min="0" placeholder="0">
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                        <select class="form-select" id="productCategory">
                            <option value="">Select category...</option>
                            <option>Electronics</option>
                            <option>Clothing</option>
                            <option>Books</option>
                            <option>Home</option>
                            <option>Sports</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2 mt-2">
                        <button class="btn btn-primary px-4" onclick="createProduct()" id="submitBtn">
                            <i class="fas fa-plus me-2"></i>Create Product
                        </button>
                        <a href="/admin/products" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Image Upload -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0 fw-semibold"><i class="fas fa-image me-2 text-primary"></i>Product Image</h6>
            </div>
            <div class="card-body p-3">
                <!-- Drop Zone -->
                <div id="dropZone" onclick="triggerFileInput()"
                     style="border:2px dashed #cbd5e1;border-radius:12px;padding:2rem 1rem;
                            cursor:pointer;transition:all 0.2s;text-align:center;min-height:200px;
                            display:flex;flex-direction:column;align-items:center;justify-content:center;background:#f8fafc;">
                    <i class="fas fa-cloud-upload-alt" style="font-size:2.5rem;color:#94a3b8;margin-bottom:0.75rem;"></i>
                    <p class="mb-1 fw-semibold" style="color:#475569;">Click or drag to upload</p>
                    <p class="mb-0 text-muted" style="font-size:0.8rem;">JPG, PNG, WEBP up to 10MB</p>
                </div>

                <!-- Preview -->
                <div id="imagePreview" style="display:none;position:relative;">
                    <img id="previewImg" src="" alt="Preview"
                         style="width:100%;border-radius:12px;max-height:260px;object-fit:cover;">
                    <button onclick="removeImage()"
                            style="position:absolute;top:8px;right:8px;background:rgba(0,0,0,0.6);
                                   color:white;border:none;border-radius:50%;width:30px;height:30px;
                                   cursor:pointer;font-size:0.8rem;">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <!-- Upload progress -->
                <div id="uploadProgress" style="display:none;" class="mt-3">
                    <div class="d-flex justify-content-between mb-1">
                        <small class="text-muted">Uploading...</small>
                        <small id="progressPct" class="text-muted">0%</small>
                    </div>
                    <div class="progress" style="height:6px;">
                        <div id="progressBar" class="progress-bar bg-primary progress-bar-striped progress-bar-animated" style="width:0%"></div>
                    </div>
                </div>

                <!-- URL input -->
                <div class="mt-3">
                    <label class="form-label fw-semibold" style="font-size:0.85rem;">
                        Image URL <span class="text-muted fw-normal">(auto-filled on upload)</span>
                    </label>
                    <div class="input-group input-group-sm">
                        <input type="url" class="form-control" id="productImageUrl"
                               placeholder="https://..."
                               oninput="onManualUrlChange(this.value)">
                        <button class="btn btn-outline-secondary" type="button" onclick="previewFromUrl()" title="Preview">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <!-- Upload status badge -->
                <div id="uploadStatus" class="mt-2" style="display:none;">
                    <span class="badge bg-success bg-opacity-10 text-success">
                        <i class="fas fa-check-circle me-1"></i>
                        <span id="uploadStatusText">Image uploaded</span>
                    </span>
                </div>

                <input type="file" id="fileInput" accept="image/*,video/*" style="display:none;" onchange="handleFileSelect(event)">
            </div>
        </div>

        <!-- Tips -->
        <div class="card mt-3">
            <div class="card-body p-3">
                <h6 class="fw-semibold mb-2" style="font-size:0.85rem;color:#475569;">
                    <i class="fas fa-lightbulb text-warning me-1"></i> Tips
                </h6>
                <ul class="mb-0 ps-3" style="font-size:0.8rem;color:#64748b;line-height:1.8;">
                    <li>Use square images (1:1) for best display</li>
                    <li>Minimum 500×500px recommended</li>
                    <li>White or transparent backgrounds work best</li>
                    <li>Max file size: 10MB</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const apiBaseUrl   = '@Model.ApiBaseUrl';
const cloudName    = '@Model.CloudName';
const uploadPreset = '@Model.UploadPreset';

// ── Drag & Drop ───────────────────────────────────────────────────────────────
const dropZone = document.getElementById('dropZone');

dropZone.addEventListener('dragover', e => {
    e.preventDefault();
    dropZone.style.borderColor = '#3b82f6';
    dropZone.style.background  = '#eff6ff';
});
dropZone.addEventListener('dragleave', () => {
    dropZone.style.borderColor = '#cbd5e1';
    dropZone.style.background  = '#f8fafc';
});
dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.style.borderColor = '#cbd5e1';
    dropZone.style.background  = '#f8fafc';
    const file = e.dataTransfer.files[0];
    if (file) uploadFile(file);
});

function triggerFileInput() { document.getElementById('fileInput').click(); }
function handleFileSelect(e) { const file = e.target.files[0]; if (file) uploadFile(file); }

// ── Cloudinary Upload ─────────────────────────────────────────────────────────
async function uploadFile(file) {
    const isImage = file.type.startsWith('image/');
    const isVideo = file.type.startsWith('video/');
    if (!isImage && !isVideo) { showAlert('Only image and video files are supported.', 'danger'); return; }
    if (file.size > 10 * 1024 * 1024) { showAlert('File size must be under 10MB.', 'danger'); return; }

    document.getElementById('dropZone').style.display     = 'none';
    document.getElementById('imagePreview').style.display = 'none';
    document.getElementById('uploadProgress').style.display = 'block';
    document.getElementById('uploadStatus').style.display   = 'none';

    const formData = new FormData();
    formData.append('file', file);
    formData.append('upload_preset', uploadPreset);
    formData.append('folder', 'secureshop/products');

    const resourceType = isVideo ? 'video' : 'image';
    const uploadUrl = `https://api.cloudinary.com/v1_1/${cloudName}/${resourceType}/upload`;

    try {
        const url = await new Promise((resolve, reject) => {
            const xhr = new XMLHttpRequest();
            xhr.open('POST', uploadUrl);
            xhr.upload.onprogress = e => {
                if (e.lengthComputable) {
                    const pct = Math.round(e.loaded / e.total * 100);
                    document.getElementById('progressBar').style.width = pct + '%';
                    document.getElementById('progressPct').textContent = pct + '%';
                }
            };
            xhr.onload = () => {
                if (xhr.status === 200) resolve(JSON.parse(xhr.responseText).secure_url);
                else reject(new Error('Upload failed'));
            };
            xhr.onerror = () => reject(new Error('Network error'));
            xhr.send(formData);
        });

        document.getElementById('uploadProgress').style.display = 'none';
        document.getElementById('productImageUrl').value = url;

        if (isImage) {
            document.getElementById('previewImg').src             = url;
            document.getElementById('imagePreview').style.display = 'block';
        } else {
            document.getElementById('dropZone').style.display = 'flex';
            dropZone.innerHTML = `
                <i class="fas fa-video" style="font-size:2.5rem;color:#3b82f6;margin-bottom:0.75rem;"></i>
                <p class="mb-0 fw-semibold" style="color:#1e293b;">Video uploaded</p>
                <p class="mb-0 text-muted" style="font-size:0.8rem;">${file.name}</p>`;
        }

        document.getElementById('uploadStatus').style.display = 'block';
        document.getElementById('uploadStatusText').textContent =
            isVideo ? 'Video uploaded to Cloudinary' : 'Image uploaded to Cloudinary';

    } catch (err) {
        document.getElementById('uploadProgress').style.display = 'none';
        document.getElementById('dropZone').style.display       = 'flex';
        showAlert('Upload failed. Check your Cloudinary config.', 'danger');
        console.error('Cloudinary upload error:', err);
    }
}

// ── Manual URL ────────────────────────────────────────────────────────────────
function previewFromUrl() {
    const url = document.getElementById('productImageUrl').value.trim();
    if (!url) return;
    document.getElementById('previewImg').src             = url;
    document.getElementById('imagePreview').style.display = 'block';
    document.getElementById('dropZone').style.display     = 'none';
    document.getElementById('uploadStatus').style.display = 'block';
    document.getElementById('uploadStatusText').textContent = 'Using external URL';
}

function onManualUrlChange(val) {
    if (!val) document.getElementById('uploadStatus').style.display = 'none';
}

function removeImage() {
    document.getElementById('productImageUrl').value      = '';
    document.getElementById('imagePreview').style.display = 'none';
    document.getElementById('uploadStatus').style.display = 'none';
    document.getElementById('dropZone').style.display     = 'flex';
    document.getElementById('dropZone').innerHTML = `
        <i class="fas fa-cloud-upload-alt" style="font-size:2.5rem;color:#94a3b8;margin-bottom:0.75rem;"></i>
        <p class="mb-1 fw-semibold" style="color:#475569;">Click or drag to upload</p>
        <p class="mb-0 text-muted" style="font-size:0.8rem;">JPG, PNG, WEBP up to 10MB</p>`;
    document.getElementById('fileInput').value = '';
}

// ── Create Product ────────────────────────────────────────────────────────────
async function createProduct() {
    const name        = document.getElementById('productName').value.trim();
    const description = document.getElementById('productDescription').value.trim();
    const price       = parseFloat(document.getElementById('productPrice').value);
    const stock       = parseInt(document.getElementById('productStock').value);
    const category    = document.getElementById('productCategory').value;
    const imageUrl    = document.getElementById('productImageUrl').value.trim();

    if (!name || !description || isNaN(price) || price < 0 || isNaN(stock) || stock < 0 || !category) {
        showAlert('Please fill in all required fields correctly.', 'danger');
        return;
    }

    const btn = document.getElementById('submitBtn');
    btn.disabled  = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creating...';

    try {
        const res = await fetch(`${apiBaseUrl}/api/products`, {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, description, price, stockQuantity: stock, category, imageUrl: imageUrl || null })
        });
        if (res.ok) {
            window.location.replace('/admin/products');
        } else {
            const err = await res.json().catch(() => ({}));
            showAlert(err.message || 'Failed to create product.', 'danger');
            btn.disabled  = false;
            btn.innerHTML = '<i class="fas fa-plus me-2"></i>Create Product';
        }
    } catch (e) {
        showAlert('Server error. Try again.', 'danger');
        btn.disabled  = false;
        btn.innerHTML = '<i class="fas fa-plus me-2"></i>Create Product';
    }
}

function showAlert(msg, type) {
    document.getElementById('formAlert').innerHTML =
        `<div class="alert alert-${type} alert-dismissible fade show">
            <i class="fas fa-${type==='danger'?'exclamation-circle':'check-circle'} me-2"></i>${msg}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
         </div>`;
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

function getCookie(n) {
    const v = `; ${document.cookie}`, p = v.split(`; ${n}=`);
    if (p.length === 2) return p.pop().split(';').shift();
    return null;
}
</script>
}
