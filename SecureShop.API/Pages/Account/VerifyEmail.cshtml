@page "/account/verify-email"
@model SecureShop.API.Pages.Account.VerifyEmailModel
@{
    ViewData["Title"] = "Verify Email";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                             style="width:72px;height:72px;background:linear-gradient(135deg,#3b82f6,#2563eb);">
                            <i class="fas fa-envelope-open-text text-white" style="font-size:2rem;"></i>
                        </div>
                        <h2 class="fw-bold">Check your email</h2>
                        <p class="text-muted">
                            We sent a 6-digit code to<br>
                            <strong>@Model.Email</strong>
                        </p>
                    </div>

                    @if (Model.ErrorMessage != null)
                    {
                        <div class="alert alert-danger text-start" role="alert">
                            <i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage
                        </div>
                    }

                    <form method="post">
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="PendingUserId" />
                        <input type="hidden" asp-for="PendingToken" />

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Enter verification code</label>
                            <input type="text" class="form-control form-control-lg text-center fw-bold"
                                   asp-for="OtpCode"
                                   placeholder="000000"
                                   maxlength="6"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   style="font-size:2rem;letter-spacing:10px;"
                                   required />
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-check-circle me-2"></i>Verify Email
                            </button>
                        </div>
                    </form>

                    <p class="text-muted small">
                        Didn't receive the code?
                        <a href="/account/register" class="text-decoration-none">Try registering again</a>
                    </p>

                    <div class="text-center mt-3">
                        <a href="/" class="text-decoration-none text-muted small">
                            <i class="fas fa-arrow-left me-1"></i>Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
