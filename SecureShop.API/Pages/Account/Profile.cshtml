@page
@model SecureShop.API.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body p-5">
                    <!-- Header -->
                    <div class="text-center mb-4">
                        <img src="/secureshop-logo.svg" alt="SecureShop Logo" style="height: 60px;">
                        <h2 class="mt-3 mb-2">My Profile</h2>
                        <p class="text-muted">View and manage your account information</p>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@Model.SuccessMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>@Model.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Profile Information -->
                    <form method="post">
                        <div class="mb-4">
                            <h5 class="text-secondary mb-3">
                                <i class="fas fa-user me-2"></i>Personal Information
                            </h5>
                            
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="firstName" class="form-label">First Name</label>
                                    <input type="text" class="form-control form-control-lg" id="firstName" 
                                           name="FirstName" asp-for="FirstName" readonly>
                                </div>
                                <div class="col-md-6">
                                    <label for="lastName" class="form-label">Last Name</label>
                                    <input type="text" class="form-control form-control-lg" id="lastName" 
                                           name="LastName" asp-for="LastName" readonly>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="email" class="form-label">Email Address</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                    <input type="email" class="form-control form-control-lg" id="email" 
                                           name="Email" asp-for="Email" readonly>
                                </div>
                                <small class="text-muted">Your email is used for login and notifications</small>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Account Security -->
                        <div class="mb-4">
                            <h5 class="text-secondary mb-3">
                                <i class="fas fa-shield-alt me-2"></i>Account Security
                            </h5>
                            <div class="d-grid gap-2">
                                <button type="button" class="btn btn-outline-primary btn-lg" disabled>
                                    <i class="fas fa-key me-2"></i>Change Password (Coming Soon)
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-lg" disabled>
                                    <i class="fas fa-mobile-alt me-2"></i>Enable Two-Factor Authentication (Coming Soon)
                                </button>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Quick Links -->
                        <div class="mb-3">
                            <h5 class="text-secondary mb-3">
                                <i class="fas fa-bolt me-2"></i>Quick Actions
                            </h5>
                            <div class="d-grid gap-2">
                                <a href="/account/orders" class="btn btn-outline-success btn-lg">
                                    <i class="fas fa-box me-2"></i>View My Orders
                                </a>
                                <a href="/products" class="btn btn-outline-info btn-lg">
                                    <i class="fas fa-shopping-bag me-2"></i>Browse Products
                                </a>
                            </div>
                        </div>
                    </form>

                    <hr class="my-4">

                    <div class="text-center">
                        <p class="text-muted mb-2">Need to update your information?</p>
                        <small class="text-muted">Please contact support at <a href="mailto:support@secureshop.com">support@secureshop.com</a></small>
                    </div>

                    <div class="text-center mt-4">
                        <a href="/" class="text-decoration-none">
                            <i class="fas fa-arrow-left"></i> Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
