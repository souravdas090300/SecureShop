@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <img src="/secureshop-logo.svg" alt="SecureShop Logo" style="height: 60px; width: auto;" class="mb-3">
                        <h2 class="fw-bold">Create Account</h2>
                        <p class="text-muted">Join SecureShop today</p>
                    </div>

                    @if (Model.ErrorMessage != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="fas fa-exclamation-circle"></i> @Model.ErrorMessage
                        </div>
                    }

                    <!-- Google Sign Up -->
                    <div class="d-grid mb-3">
                        <button type="button" class="btn btn-outline-danger btn-lg" onclick="signUpWithGoogle()">
                            <i class="fab fa-google me-2"></i> Sign up with Google
                        </button>
                    </div>

                    <div class="text-center my-3">
                        <span class="text-muted">OR</span>
                    </div>

                    <!-- Email Registration Form -->
                    <form method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="firstName" class="form-label">First Name *</label>
                                <input type="text" class="form-control form-control-lg" id="firstName" 
                                       name="FirstName" asp-for="FirstName" placeholder="John" required>
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="lastName" class="form-label">Last Name *</label>
                                <input type="text" class="form-control form-control-lg" id="lastName" 
                                       name="LastName" asp-for="LastName" placeholder="Doe" required>
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email Address *</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input type="email" class="form-control form-control-lg" id="email" 
                                       name="Email" asp-for="Email" placeholder="john.doe@example.com" required>
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Password *</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input type="password" class="form-control form-control-lg" id="password" 
                                       name="Password" asp-for="Password" placeholder="Min 8 characters" required>
                            </div>
                            <small class="text-muted">
                                Must be at least 8 characters with uppercase, lowercase, number, and special character.
                            </small>
                            <span asp-validation-for="Password" class="text-danger small d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">Confirm Password *</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input type="password" class="form-control form-control-lg" id="confirmPassword" 
                                       name="ConfirmPassword" asp-for="ConfirmPassword" placeholder="Re-enter password" required>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                            <label class="form-check-label" for="agreeTerms">
                                I agree to the <a href="#" class="text-decoration-none">Terms of Service</a> 
                                and <a href="#" class="text-decoration-none">Privacy Policy</a>
                            </label>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-user-plus"></i> Create Account
                            </button>
                        </div>
                    </form>

                    <hr class="my-4">

                    <div class="text-center">
                        <p class="mb-0">Already have an account? 
                            <a href="/account/login" class="text-decoration-none fw-bold">Sign in</a>
                        </p>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="/" class="text-decoration-none">
                    <i class="fas fa-arrow-left"></i> Back to Home
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script>
        let googleClientId = '@Model.GoogleClientId';

        // Initialize Google Sign-Up
        window.onload = function() {
            // Initialize Google Identity Services
            if (typeof google !== 'undefined') {
                google.accounts.id.initialize({
                    client_id: googleClientId,
                    callback: handleCredentialResponse
                });
            }
        };

        function signUpWithGoogle() {
            // Trigger Google One Tap or the button flow
            if (typeof google !== 'undefined') {
                google.accounts.id.prompt(); // Show One Tap dialog
            } else {
                alert('Google Sign-In is not loaded yet. Please try again.');
            }
        }

        // Handle Google Sign-Up callback
        async function handleCredentialResponse(response) {
            try {
                // Send the Google ID token to your backend
                const result = await fetch('/api/auth/google-signin', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ idToken: response.credential })
                });

                const data = await result.json();

                if (result.ok && data.token) {
                    // Store authentication data
                    document.cookie = `AuthToken=${data.token}; path=/; max-age=28800`; // 8 hours
                    document.cookie = `UserEmail=${data.email}; path=/; max-age=28800`;
                    document.cookie = `UserName=${data.name}; path=/; max-age=28800`;
                    
                    // Redirect to home page
                    window.location.href = '/';
                } else {
                    alert(data.message || 'Google sign-up failed. Please try again.');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred during Google sign-up. Please try again.');
            }
        }

        // Password strength indicator
        document.getElementById('password')?.addEventListener('input', function(e) {
            const password = e.target.value;
            const strength = calculatePasswordStrength(password);
            // You can add visual feedback here
        });

        function calculatePasswordStrength(password) {
            let strength = 0;
            if (password.length >= 8) strength++;
            if (password.match(/[a-z]/)) strength++;
            if (password.match(/[A-Z]/)) strength++;
            if (password.match(/[0-9]/)) strength++;
            if (password.match(/[^a-zA-Z0-9]/)) strength++;
            return strength;
        }

        // Confirm password validation
        document.getElementById('confirmPassword')?.addEventListener('input', function(e) {
            const password = document.getElementById('password').value;
            const confirmPassword = e.target.value;
            
            if (password !== confirmPassword) {
                e.target.setCustomValidity('Passwords do not match');
            } else {
                e.target.setCustomValidity('');
            }
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}
