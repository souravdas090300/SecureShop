@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- Success Message (from TempData after registration/login) -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mx-auto mt-3" role="alert" style="max-width: 800px;">
        <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container text-center">
        <h1 class="display-4 fw-bold mb-4">Welcome to SecureShop</h1>
        <p class="lead mb-4">Discover amazing products at unbeatable prices</p>
        <a href="/products" class="btn btn-light btn-lg px-5">
            <i class="fas fa-shopping-bag me-2"></i>Shop Now
        </a>
    </div>
</section>

<!-- Features Section -->
<div class="container mb-5">
    <div class="row text-center g-4">
        <div class="col-md-4">
            <div class="p-4">
                <i class="fas fa-shipping-fast fa-3x text-primary mb-3"></i>
                <h5>Fast Delivery</h5>
                <p class="text-muted">Get your orders delivered quickly and safely</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4">
                <i class="fas fa-shield-alt fa-3x text-success mb-3"></i>
                <h5>Secure Payments</h5>
                <p class="text-muted">Shop with confidence using our secure payment system</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4">
                <i class="fas fa-headset fa-3x text-info mb-3"></i>
                <h5>24/7 Support</h5>
                <p class="text-muted">Our customer support team is always here to help</p>
            </div>
        </div>
    </div>
</div>

<!-- Featured Products Section -->
<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold">Featured Products</h2>
            <p class="text-muted">Check out our latest and most popular items</p>
        </div>
    </div>
    
    @if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
    {
        <div class="row g-4" id="productGrid">
            @foreach (var product in Model.FeaturedProducts)
            {
                <div class="col-md-4 col-lg-3">
                    <div class="product-card">
                        <div class="product-image">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name"
                                     style="width:100%;height:100%;object-fit:cover;"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
                                <i class="fas fa-box" style="display:none;"></i>
                            }
                            else
                            {
                                <i class="fas fa-box"></i>
                            }
                        </div>
                        <div class="product-info">
                            <span class="category-badge">@product.Category</span>
                            <h5 class="mt-2 mb-1">@product.Name</h5>
                            <p class="text-muted small mb-2">@product.Description.Substring(0, Math.Min(60, product.Description.Length))...</p>
                            <div class="product-price">$@product.Price.ToString("F2")</div>
                            
                            @if (product.StockQuantity > 0)
                            {
                                <span class="stock-badge in-stock">
                                    <i class="fas fa-check-circle"></i> In Stock
                                </span>
                            }
                            else
                            {
                                <span class="stock-badge out-of-stock">
                                    <i class="fas fa-times-circle"></i> Out of Stock
                                </span>
                            }
                            
                            <div class="mt-3 d-grid">
                                @if (product.StockQuantity > 0)
                                {
                                    <button class="btn btn-primary" onclick="addToCart('@product.Id', '@product.Name', @product.Price)">
                                        <i class="fas fa-cart-plus"></i> Add to Cart
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary" disabled>
                                        <i class="fas fa-ban"></i> Unavailable
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No products available yet. Check back soon!
        </div>
    }
    
    <div class="text-center mt-5">
        <a href="/products" class="btn btn-outline-primary btn-lg">
            View All Products <i class="fas fa-arrow-right ms-2"></i>
        </a>
    </div>
</div>

@section Scripts {
    <script>
        function addToCart(productId, productName, price) {
            // Get existing cart from localStorage
            let cart = JSON.parse(localStorage.getItem('cart') || '[]');
            
            // Check if product already in cart
            const existingItem = cart.find(item => item.id === productId);
            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                cart.push({
                    id: productId,
                    name: productName,
                    price: price,
                    quantity: 1
                });
            }
            
            // Save to localStorage
            localStorage.setItem('cart', JSON.stringify(cart));
            updateCartBadge();
            
            // Show success message
            alert(`${productName} added to cart!`);
        }
    </script>
}
