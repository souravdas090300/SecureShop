# ─────────────────────────────────────────────────────────────────────────────
# SecureShop environment template — DO NOT put real secrets in this file.
#
# ASP.NET Core does NOT load .env files automatically. These files are a
# reference for the variables the app reads:
#   - Production (Railway): set them in the service's Variables tab.
#   - Local dev: use `dotnet user-secrets` or copy values into
#     SecureShop.API/Properties/launchSettings.json environment variables.
#
# Naming: configuration sections use double underscores (Jwt__Secret maps to
# the "Jwt:Secret" key). PORT and ASPNETCORE_ENVIRONMENT are set by the host.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
# PORT is injected automatically by Railway — do not set it.

# ── Database (required) ──────────────────────────────────────────────────────
# Neon pooled connection string recommended. Get it from the Neon console or
# `neonctl connection-string`. sslmode=require is handled by Npgsql defaults.
ConnectionStrings__DefaultConnection=Host=YOUR_HOST;Username=YOUR_USER;Password=YOUR_PASSWORD;Database=neondb;SSL Mode=Require

# ── Redis (optional) ─────────────────────────────────────────────────────────
# Upstash or any StackExchange.Redis-compatible endpoint. Leave empty to run
# with the no-op cache (everything works, just uncached).
ConnectionStrings__Redis=

# ── JWT auth (required) ──────────────────────────────────────────────────────
# Generate a long random secret, e.g. `openssl rand -base64 48`.
Jwt__Secret=
Jwt__Issuer=SecureShop
Jwt__Audience=SecureShopUsers

# ── Stripe (required for checkout) ───────────────────────────────────────────
# Test mode: keys start with pk_test_ / sk_test_. WebhookSecret (whsec_...) comes
# from the endpoint you register in the Stripe dashboard:
#   https://YOUR-DOMAIN/api/webhooks/stripe
Stripe__SecretKey=sk_test_...
Stripe__PublishableKey=
Stripe__WebhookSecret=

# ── Order lifecycle (optional; defaults shown) ────────────────────────────────
# Unpaid PaymentProcessing orders older than this are cancelled and their stock
# released by the background abandonment sweep.
Orders__AbandonAfterMinutes=30
# How often the abandonment sweep runs.
Orders__AbandonmentIntervalMinutes=5

# ── Google OAuth (optional) ──────────────────────────────────────────────────
GoogleAuth__ClientId=
GoogleAuth__ClientSecret=

# ── Email / SMTP (optional until password-reset email is enabled) ────────────
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__SmtpUser=
Email__SmtpPassword=
Email__FromName=SecureShop

# ── Cloudinary (optional — product image uploads) ────────────────────────────
Cloudinary__CloudName=
Cloudinary__UploadPreset=secureshop_products

# ── CORS (optional — comma-separated origins allowed by the API) ─────────────
AllowedOrigins=

# ── Admin bootstrap (one-time only — remove after first admin exists) ────────
# Both must be set together; the provisioner skips if an Admin-role user exists.
BootstrapAdmin__Email=
BootstrapAdmin__Password=
